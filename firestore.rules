rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Optical ERP collections: allow read and write for app operational workflows
    match /stores/{storeId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /employees/{employeeId} {
      allow read, write: if true;
    }

    match /products/{productId} {
      allow read, write: if true;
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /ads_campaigns/{adId} {
      allow read, write: if true;
    }

    match /discount_coupons/{couponId} {
      allow read, write: if true;
    }

    match /faset_orders/{orderId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
