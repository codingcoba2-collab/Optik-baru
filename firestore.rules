rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Stores: publicly viewable in marketplace, writable by owner
    match /stores/{storeId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Users
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Employees
    match /employees/{employeeId} {
      allow read, write: if request.auth != null;
    }

    // Products: publicly viewable in marketplace, manageable by authenticated seller
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Orders: readable and writeable by order parties
    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // Ads and Discounts
    match /ads_campaigns/{adId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /discount_coupons/{couponId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Faset Orders
    match /faset_orders/{orderId} {
      allow read, write: if request.auth != null;
    }
  }
}
